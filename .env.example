# Copia este archivo como .env y completa los valores. NUNCA subas .env.
# Todos los valores de abajo son ejemplos, no credenciales reales.

# Base de datos
POSTGRES_DB=talenti
# Administrador de la imagen (superusuario). Solo se usa para crear la base y el rol de la
# aplicación; el backend NO se conecta con él.
POSTGRES_USER=talenti_admin
POSTGRES_PASSWORD=cambia-esto-en-tu-.env
# Rol de la aplicación (sin superusuario, dueño del esquema). Lo usan Flyway y el backend.
# Estos valores se aplican al crear el volumen; si los cambias después, usa "docker compose down -v".
APP_DB_USER=talenti_app
APP_DB_PASSWORD=cambia-esto-tambien-en-tu-.env

# NOTA (spec 004): el script db/init/01-init-roles.sh también crea las extensiones "unaccent" y "pg_trgm" (búsqueda sin tildes y tolerante a errores de tipeo).
# Si tu volumen de la base de datos es anterior a ese cambio, el backend no arranca: ejecuta
# "docker compose down -v" (borra los datos locales) y vuelve a levantar.

# Puerto local desde el que abres la aplicación en el navegador
FRONTEND_PORT=3000

# IA y voz: "simulated" no usa ningún servicio externo.
# Cambia a "openai" solo cuando exista la cuenta y la clave.
AI_PROVIDER=simulated
VOICE_PROVIDER=simulated
# Tu clave de OpenAI (empieza con "sk-"). Solo va aquí, en tu .env: NO la subas al repositorio, no la pegues en
# el chat ni la escribas en ningún otro archivo. Déjala vacía mientras uses el modo simulado.
OPENAI_API_KEY=

# Lectura de CV con IA real (opcional). Para probarla, cambia estas TRES cosas (ver README, "Probar la lectura de
# CV con IA real"): AI_PROVIDER=openai, TALENTI_AI_CV_ENABLED=true y un modelo en TALENTI_AI_CV_MODEL.
# true = aparece "Leer mejor con IA" y se envía el texto REDUCIDO del CV (sin correo, teléfono, DNI ni dirección)
# a OpenAI. false = todo se lee con reglas, sin enviar nada a nadie.
TALENTI_AI_CV_ENABLED=false
# Modelo de OpenAI a usar; elige uno económico de tu lista de modelos. Ejemplo: gpt-4o-mini
# (confirma el nombre vigente y su precio en la página de OpenAI). Si queda vacío con la IA encendida, el
# backend no arranca y lo dice en el registro.
TALENTI_AI_CV_MODEL=
# Topes de seguridad de gasto entre todas las personas: lecturas con IA por día y por mes. Cada persona además
# tiene 3 lecturas con IA al mes. Cuando se acaban, la lectura básica (reglas) sigue funcionando.
TALENTI_AI_LIMITS_GLOBAL_DAILY=100
TALENTI_AI_LIMITS_GLOBAL_MONTHLY=1500

# Tope técnico de sesiones de práctica por usuario y mes (alto para la demo)
PRACTICE_SESSIONS_PER_MONTH=999

# Datos de ejemplo (spec 004): 8 empresas y 12 vacantes FICTICIAS de programación, sin marcas reales ni logos.
# true  = Flyway también carga classpath:db/demo (migraciones V1000 en adelante). Es lo que quieres para la demo.
# false = solo el esquema; en un entorno real sin convenios el listado queda vacío. Si no defines la variable,
#         el backend la toma como false (y el perfil "prod" también). Docker Compose la enciende por defecto.
# Apagarla después de haberla encendido no borra lo cargado; para empezar de cero usa "docker compose down -v".
TALENTI_DEMO_DATA=true
